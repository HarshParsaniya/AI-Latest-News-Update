# Copy to secret.yaml (do not commit) or create with:
# kubectl create secret generic ai-news-digest-secrets --from-env-file=.env
apiVersion: v1
kind: Secret
metadata:
  name: ai-news-digest-secrets
type: Opaque
stringData:
  GEMINI_API_KEY: "replace-me"
  GROQ_API_KEY: ""
  MODEL_NAME: "gemini-2.0-flash"
  LANGFUSE_PUBLIC_KEY: ""
  LANGFUSE_SECRET_KEY: ""
  LANGFUSE_HOST: "https://cloud.langfuse.com"
  SMTP_HOST: "smtp.gmail.com"
  SMTP_PORT: "587"
  SMTP_USER: "you@gmail.com"
  SMTP_APP_PASSWORD: "replace-me"
  DIGEST_FROM_EMAIL: "you@gmail.com"
  DIGEST_TO_EMAIL: "you@gmail.com"
  WHATSAPP_ENABLED: "false"
  CALLMEBOT_PHONE: ""
  CALLMEBOT_APIKEY: ""
  DIGEST_TZ: "Asia/Kolkata"
  TARGET_ITEM_COUNT: "10"
  DRY_RUN: "false"
