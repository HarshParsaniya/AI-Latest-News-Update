# LLM — set one of these (Gemini preferred; Groq is the alternate)
GEMINI_API_KEY=
GROQ_API_KEY=
MODEL_NAME=gemini-2.0-flash

# Langfuse (optional; skip tracing if empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Gmail SMTP (required for live email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
DIGEST_FROM_EMAIL=
DIGEST_TO_EMAIL=

# WhatsApp via CallMeBot (optional; job still emails if this is off/fails)
WHATSAPP_ENABLED=false
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
CALLMEBOT_MAX_CHARS=1500

# Runtime
DIGEST_TZ=Asia/Kolkata
TARGET_ITEM_COUNT=10
SQLITE_PATH=./data/digest.db
DRY_RUN=false
EXTRACT_ARTICLE_TEXT=false
